node_modules/
dist/
*.enc
*.audit.jsonl
FETCH_HEAD

# Explicitly ignore any keystore or audit log at the repo root.
# These files may be created by running the CLI in the repo directory
# during development. They must never be committed — they could contain
# real key material or sensitive audit entries.
pyhsm-keystore.enc
pyhsm-keystore.enc.audit.jsonl

# License signing key — NEVER commit the private key
tools/license_private.pem
license_private.pem
*.jwt

# Generated by Python, pytest, coverage and packaging. Never commit them: they change on every
# run (so a test run dirties the working tree and gets in the way of git operations), they are
# specific to one machine's Python version, and the .egg-info copies of the metadata drift from
# pyproject.toml.
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
build/
